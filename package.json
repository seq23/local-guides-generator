    "phase6:build-batches": "node scripts/recommendations/build_phase6_batches.js",
    "phase6:normalize-pdfs": "node scripts/recommendations/normalize_pdf_recommendations.js",
    "phase7:build-review-bundle": "node scripts/release/build_phase7_review_bundle.js && node scripts/release/build_phase7_release_notes.js",
    "postbuild": "node scripts/lastmod_apply.js && node scripts/sitemap_emit.js && node scripts/llms_emit.js && node scripts/citation_manifest_emit.js && node scripts/indexnow_emit.js && node scripts/distribution_manifest_emit.js && node scripts/redirects_emit.js && node scripts/copy_indexnow_key_to_dist.js && node scripts/copy_routes_config_to_dist.js && node scripts/snapshot_lkg.js && node scripts/validate_tbs.js",
