    "probe:citations": "CITATION_PROBE_MODE=grounded node scripts/llm_citation_probe.mjs --limit 30",
    "probe:queries": "node scripts/citation_probe_queries_emit.js",
    "qa:final": "npm run validate:tier:hard-fail && npm run validate:tier:warning && npm run validate:tier:developer",
    "qa:release": "node scripts/qa_release.js",
    "refresh:verification": "bash scripts/automation/refresh_verification_page.sh && node scripts/lastmod_apply.js && node scripts/sitemap_emit.js && node scripts/llms_emit.js && node scripts/citation_manifest_emit.js && node scripts/distribution_manifest_emit.js && node scripts/redirects_emit.js && node scripts/snapshot_lkg.js",
    "reseed:lastmod": "node scripts/reseed_lastmod_from_git.js",
    "retrofit:recommendation-summary": "PAGES_OUT_DIR=dist node scripts/retrofit_recommendation_summary.js",
    "sitemap:lastmod": "node scripts/sitemap_lastmod.js",
    "smoke:buyouts": "node scripts/smoke_buyouts.js",
    "snapshot:baseline": "bash scripts/make_baseline_snapshot.sh",
    "snapshot:baseline:with-git": "bash scripts/make_baseline_snapshot.sh --include-git",
    "snapshot:lkg": "node scripts/snapshot_lkg.js",
    "sync:guides": "node scripts/sync_guides.js",
    "test:blocked-lead-domains": "node --test tests/request_form/blocked_lead_domains.test.mjs",
    "test:lead-guard": "node --test tests/request_form/lead_guard.test.mjs",
    "test:edge-cache": "node --test tests/edge_cache/edge_cache_config.test.mjs",
    "test:homepage-shape": "node --test tests/homepage/homepage_shape.test.mjs",
    "test:indexnow-named-stop": "node --test tests/indexnow/indexnow_named_stop.test.mjs",
    "test:lastmod-sources": "node --test tests/lastmod/*.test.mjs",
    "test:link-audit": "node --test tests/links/link_audit.test.mjs",
    "test:llm-router": "node --test tests/llm_router/free_llm_router_403.test.mjs tests/llm_router/free_llm_router_empty.test.mjs",
    "test:neuro-services": "node --test tests/neuro/neuro_services.test.mjs",
    "test:request-form-own-vertical": "node --test tests/request_form/own_vertical.test.mjs",
    "test:search-readiness": "node --test tests/search_readiness/scoped_repair.test.mjs tests/search_readiness/no_petty_floors.test.mjs tests/search_readiness/guide_content.test.mjs tests/search_readiness/fanout_subject.test.mjs tests/search_readiness/guide_top_module.test.mjs tests/search_readiness/state_local_facts.test.mjs",
    "test:senior": "node --test tests/senior/*.test.mjs",
    "test:site-chrome": "node --test tests/site_chrome/site_chrome_parity.test.mjs",
    "test:structured-data": "node --test tests/schema/structured_data_vocab.test.mjs",
    "test:trt-affiliates": "node --test tests/trt/trt_affiliates.test.mjs",
    "validate": "node scripts/validate_tbs.js",
    "validate:all": "npm run validate:tier:hard-fail",
    "validate:dist": "rm -rf dist && node scripts/build_all_packs.js && LKG_VALIDATE_DIST=1 npm run validate:all",
    "validate:pi:containment": "node scripts/validate_pi_keyword_containment.js",
    "validate:senior-lead": "node scripts/validation/senior_seat_schema_contract.js && node scripts/validation/senior_static_contract.js && node scripts/validation/senior_lead_flow_contract.js",
    "validate:sourced-cost-figures": "node scripts/validation/sourced_cost_figures_contract.js",
    "validate:tier:developer": "node scripts/validation/run_validator_tier.js developer",
    "validate:tier:hard-fail": "node scripts/validation/run_validator_tier.js hard_fail",
    "validate:tier:warning": "node scripts/validation/run_validator_tier.js warning",
    "validate:trt-affiliates": "node scripts/validation/trt_affiliate_links_contract.js",
    "validate:zero-paid-llm": "node scripts/validation/zero_paid_llm_contract.js",
    "test:entity-graph": "node --test tests/entity/*.test.mjs",
    "entity:watch": "node scripts/entity_backlink_watch.mjs",
    "test:search-loop": "node --test tests/search_loop/canonical_loop.test.mjs",
    "search-loop": "node scripts/search_loop/canonical_loop.mjs",
    "binders:generate": "node scripts/generate_binders.js",
    "binders:check": "node scripts/generate_binders.js --check"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
