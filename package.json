    "cadence:gate": "node scripts/cadence_gate.js",
    "distribution:bootstrap": "bash distribution_scripts/bootstrap_distribution.sh",
    "distribution:deploy": "bash distribution_scripts/deploy_distribution.sh",
    "distribution:prepare": "npm run build:all && LKG_VALIDATE_DIST=1 npm run validate:all",
    "indexnow:ping": "node scripts/indexnow_ping.js",
    "install:clarity": "PAGES_OUT_DIR=dist node scripts/install_clarity.js",
    "install:site-head-assets": "PAGES_OUT_DIR=dist node scripts/install_site_head_assets.js",
    "lastmod:apply": "node scripts/lastmod_apply.js",
