{
  "route": "/request-assistance/",
  "title": "Request assistance | %%BRAND_NAME%%",
  "description": "Use the request assistance tool to request local provider routing by category and market. Educational only. No rankings. No endorsements.",
  "main_html": "<style>\n.request-assistance-shell{\n  --ra-accent:#0b1f3a;\n  --ra-accent-2:#1f4f8a;\n  --ra-tint:#eef4fb;\n  --ra-line:rgba(11,31,58,.14);\n}\n.request-assistance-shell .ra-hero{\n  padding:24px;\n  border:1px solid var(--ra-line);\n  border-radius:24px;\n  background:linear-gradient(135deg, rgba(11,31,58,.96), rgba(31,79,138,.94));\n  color:#fff;\n  box-shadow:0 20px 40px rgba(11,31,58,.18);\n}\n.request-assistance-shell .ra-hero-grid,\n.request-assistance-shell .ra-form-grid,\n.request-assistance-shell .ra-detail-grid{\n  display:grid;\n  grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);\n  gap:18px;\n  align-items:start;\n}\n.request-assistance-shell .ra-kicker{\n  display:inline-flex;\n  align-items:center;\n  gap:8px;\n  font-size:12px;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  font-weight:700;\n  color:rgba(255,255,255,.78);\n  margin-bottom:12px;\n}\n.request-assistance-shell .ra-kicker::before{\n  content:'';\n  width:28px;\n  height:1px;\n  background:rgba(255,255,255,.55);\n}\n.request-assistance-shell .ra-hero h1{\n  margin:0 0 10px 0;\n  font-size:clamp(30px,4.8vw,48px);\n  line-height:1.05;\n  letter-spacing:-.03em;\n}\n.request-assistance-shell .ra-hero p{\n  margin:0;\n  font-size:16px;\n  color:rgba(255,255,255,.84);\n  max-width:40rem;\n}\n.request-assistance-shell .ra-hero-actions{\n  margin:18px 0 0;\n}\n.request-assistance-shell .ra-hero-actions .button{\n  min-width:200px;\n  text-align:center;\n  font-weight:700;\n  border-radius:16px;\n  padding:12px 18px;\n  box-shadow:0 10px 24px rgba(11,31,58,.18);\n}\n.request-assistance-shell .ra-pill-list{\n  display:flex;\n  flex-wrap:wrap;\n  gap:10px;\n  margin-top:16px;\n}\n.request-assistance-shell .ra-pill{\n  padding:8px 12px;\n  border-radius:999px;\n  border:1px solid rgba(255,255,255,.18);\n  background:rgba(255,255,255,.10);\n  color:#fff;\n  font-size:13px;\n  font-weight:600;\n}\n.request-assistance-shell .ra-hero-note,\n.request-assistance-shell .ra-side-note,\n.request-assistance-shell .ra-soft-card{\n  border-radius:20px;\n  border:1px solid rgba(255,255,255,.15);\n  background:rgba(255,255,255,.10);\n  padding:18px;\n}\n.request-assistance-shell .ra-hero-note h3,\n.request-assistance-shell .ra-side-note h3,\n.request-assistance-shell .ra-soft-card h3{\n  margin:0 0 8px 0;\n  font-size:16px;\n}\n.request-assistance-shell .ra-hero-note p,\n.request-assistance-shell .ra-side-note p,\n.request-assistance-shell .ra-soft-card p,\n.request-assistance-shell .ra-soft-card li,\n.request-assistance-shell .ra-side-note li{\n  color:rgba(255,255,255,.82);\n  font-size:14px;\n}\n.request-assistance-shell .ra-primary-card{\n  border-radius:24px;\n  border:1px solid rgba(11,31,58,.12);\n  background:#fff;\n  box-shadow:0 24px 48px rgba(15,23,42,.12);\n  overflow:hidden;\n}\n.request-assistance-shell .ra-primary-head{\n  padding:22px 24px 18px;\n  background:linear-gradient(180deg, rgba(11,31,58,.07), rgba(255,255,255,0));\n  border-bottom:1px solid rgba(11,31,58,.08);\n}\n.request-assistance-shell .ra-primary-label{\n  display:inline-flex;\n  align-items:center;\n  gap:8px;\n  margin-bottom:10px;\n  font-size:12px;\n  text-transform:uppercase;\n  letter-spacing:.08em;\n  font-weight:800;\n  color:var(--ra-accent-2);\n}\n.request-assistance-shell .ra-primary-label::before{\n  content:'';\n  width:8px;\n  height:8px;\n  border-radius:999px;\n  background:var(--ra-accent-2);\n}\n.request-assistance-shell .ra-primary-head h2{\n  margin:0 0 8px 0;\n  font-size:32px;\n  line-height:1.08;\n  letter-spacing:-.03em;\n  color:var(--ra-accent);\n}\n.request-assistance-shell .ra-primary-head p{\n  margin:0;\n  color:#536074;\n  font-size:15px;\n  max-width:42rem;\n}\n.request-assistance-shell .ra-form-wrap{\n  padding:22px 24px 24px;\n}\n.request-assistance-shell .ra-form-grid-fields{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:14px;\n}\n.request-assistance-shell .ra-field label,\n.request-assistance-shell .ra-checkbox span{\n  font-size:14px;\n}\n.request-assistance-shell .ra-field-title{\n  display:block;\n  margin-bottom:7px;\n  font-size:13px;\n  font-weight:700;\n  color:#304155;\n}\n.request-assistance-shell input[type=\"email\"],\n.request-assistance-shell input[type=\"tel\"],\n.request-assistance-shell input[inputmode=\"numeric\"],\n.request-assistance-shell select{\n  width:100%;\n  padding:12px 14px;\n  border-radius:14px;\n  border:1px solid rgba(11,31,58,.16);\n  background:#fff;\n  color:#0f172a;\n  box-shadow:inset 0 1px 2px rgba(15,23,42,.02);\n  font-size:15px;\n}\n.request-assistance-shell input:focus,\n.request-assistance-shell select:focus{\n  outline:none;\n  border-color:rgba(31,79,138,.65);\n  box-shadow:0 0 0 4px rgba(31,79,138,.14);\n}\n.request-assistance-shell .ra-checkbox{\n  display:flex;\n  gap:10px;\n  align-items:flex-start;\n  margin-top:14px;\n  padding:14px 16px;\n  border-radius:16px;\n  background:var(--ra-tint);\n  border:1px solid rgba(31,79,138,.10);\n}\n.request-assistance-shell .ra-checkbox input{\n  margin-top:3px;\n}\n.request-assistance-shell .ra-submit-row{\n  display:flex;\n  gap:12px;\n  align-items:center;\n  margin-top:16px;\n  flex-wrap:wrap;\n}\n.request-assistance-shell .ra-submit-row .button{\n  min-width:180px;\n  text-align:center;\n  font-weight:700;\n  border-radius:16px;\n  padding:12px 18px;\n  box-shadow:0 10px 24px rgba(11,31,58,.18);\n}\n.request-assistance-shell .ra-helper,\n.request-assistance-shell .ra-status,\n.request-assistance-shell .ra-muted-list,\n.request-assistance-shell .ra-soft-card p,\n.request-assistance-shell .ra-soft-card li{\n  color:#607086;\n}\n.request-assistance-shell .ra-helper{\n  margin-top:12px;\n  font-size:13px;\n}\n.request-assistance-shell .ra-side-note{\n  background:linear-gradient(180deg, rgba(11,31,58,.04), rgba(31,79,138,.02));\n  border:1px solid rgba(11,31,58,.09);\n  color:#10233f;\n  box-shadow:0 14px 32px rgba(15,23,42,.06);\n}\n.request-assistance-shell .ra-side-note h3,\n.request-assistance-shell .ra-side-note p,\n.request-assistance-shell .ra-side-note li{\n  color:#10233f;\n}\n.request-assistance-shell .ra-side-note ul,\n.request-assistance-shell .ra-soft-card ul{\n  margin:10px 0 0;\n  padding-left:18px;\n}\n.request-assistance-shell .ra-detail-grid{\n  grid-template-columns:repeat(2,minmax(0,1fr));\n}\n.request-assistance-shell .ra-soft-card{\n  border:1px solid rgba(11,31,58,.08);\n  background:#fff;\n  box-shadow:0 10px 24px rgba(15,23,42,.05);\n}\n.request-assistance-shell .ra-bottom-actions{\n  margin-top:16px;\n}\n.request-assistance-shell .ra-bottom-actions .button{\n  min-width:220px;\n  text-align:center;\n  font-weight:700;\n  border-radius:16px;\n  padding:12px 18px;\n}\n.request-assistance-shell .ra-soft-card h2{\n  margin:0 0 10px 0;\n  font-size:24px;\n  color:var(--ra-accent);\n}\n.request-assistance-shell .ra-soft-card h3{\n  color:var(--ra-accent);\n}\n@media (max-width: 860px){\n  .request-assistance-shell .ra-hero-grid,\n  .request-assistance-shell .ra-form-grid,\n  .request-assistance-shell .ra-detail-grid,\n  .request-assistance-shell .ra-form-grid-fields{\n    grid-template-columns:1fr;\n  }\n  .request-assistance-shell .ra-primary-head,\n  .request-assistance-shell .ra-form-wrap,\n  .request-assistance-shell .ra-hero{\n    padding-left:18px;\n    padding-right:18px;\n  }\n}\n</style>\n\n<div class=\"request-assistance-shell\">\n  <section class=\"hero ra-hero\" data-request-assistance-tool-intro=\"true\" data-request-assistance-hero-shell=\"true\">\n    <div class=\"ra-hero-grid\">\n      <div>\n        <p class=\"ra-kicker\">Request assistance</p>\n        <h1>Tell us what kind of local help you need.</h1>\n        <p>Use this page when you want a cleaner local next step without filling out a long, intimidating intake. Educational only. No rankings. No endorsements. No case details are collected here.</p>\n        <p class=\"ra-hero-actions\"><a class=\"button button-primary\" href=\"#request-assistance-form\" data-request-assistance-top-cta=\"true\">Start your request</a></p>\n        <div class=\"ra-pill-list\" aria-label=\"Key request assistance rules\">\n          <span class=\"ra-pill\">No rankings</span>\n          <span class=\"ra-pill\">No sensitive details</span>\n          <span class=\"ra-pill\">Category-based routing</span>\n        </div>\n      </div>\n      <aside class=\"ra-hero-note\" aria-label=\"Quick expectations\">\n        <h3>What to expect</h3>\n        <p>This is for people who already know the kind of provider they want and would rather submit one clean request than compare local options one by one.</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"section\" data-request-assistance-form-primary=\"true\">\n    <div class=\"ra-form-grid\">\n      <div class=\"ra-primary-card\" data-request-assistance-form-panel=\"true\">\n        <div class=\"ra-primary-head\">\n          <p class=\"ra-primary-label\">Primary action</p>\n          <h2>Submit a routing request</h2>\n          <p>Complete the short form first if you already know the provider category you need. We only ask for contact information, provider type, and optional ZIP context.</p>\n        </div>\n        <div class=\"ra-form-wrap\">\n          <form id=\"request-assistance-form\" method=\"post\" action=\"/api/request-assistance\">\n            <div class=\"ra-form-grid-fields\">\n              <div class=\"ra-field\">\n                <label>\n                  <span class=\"ra-field-title\">Provider type <span aria-hidden=\"true\">*</span></span>\n                  <select id=\"provider_type\" name=\"provider_type\" required>\n                    <option value=\"\" selected disabled>Select one</option>\n                    <option>Personal Injury Attorney</option>\n                    <option>Dentist (Cosmetic, Implant, or General Care)</option>\n                    <option>Neuro Evaluation Provider</option>\n                    <option>Hormone / Wellness Clinic</option>\n                    <option>USCIS Medical Exam Provider</option>\n                  </select>\n                </label>\n              </div>\n\n              <div class=\"ra-field\">\n                <label>\n                  <span class=\"ra-field-title\">Email <span aria-hidden=\"true\">*</span></span>\n                  <input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" required placeholder=\"you@yourmail.com\" />\n                </label>\n              </div>\n\n              <div class=\"ra-field\">\n                <label>\n                  <span class=\"ra-field-title\">Phone (optional)</span>\n                  <input id=\"phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" placeholder=\"(555) 555-5555\" />\n                </label>\n              </div>\n\n              <div class=\"ra-field\">\n                <label>\n                  <span class=\"ra-field-title\">ZIP code (optional)</span>\n                  <input id=\"zip\" name=\"zip\" inputmode=\"numeric\" pattern=\"[0-9]{5}(-[0-9]{4})?\" placeholder=\"38133\" />\n                </label>\n              </div>\n            </div>\n\n            <input type=\"hidden\" id=\"src\" name=\"src\" value=\"\" />\n            <input type=\"text\" id=\"website\" name=\"website\" value=\"\" style=\"display:none\" tabindex=\"-1\" autocomplete=\"off\" />\n\n            <label class=\"ra-checkbox\">\n              <input id=\"consent\" name=\"consent\" type=\"checkbox\" required />\n              <span>I consent to be contacted by a provider regarding this request. I understand this site is educational only and does not provide professional advice.</span>\n            </label>\n\n            <div class=\"ra-submit-row\">\n              <button type=\"submit\" class=\"button button-primary\" id=\"submit-btn\">Submit request</button>\n              <span class=\"ra-status muted\" id=\"status\" role=\"status\" aria-live=\"polite\"></span>\n            </div>\n\n            <p class=\"ra-helper\">We do not rank providers, and we do not guarantee outcomes, availability, or response time. If the form does not go through, email <a href=\"mailto:info@spryvc.com\">info@spryvc.com</a>.</p>\n          </form>\n        </div>\n      </div>\n\n      <aside class=\"ra-side-note\" aria-label=\"Before you submit\" data-request-assistance-side-note=\"true\">\n        <h3>Before you submit</h3>\n        <ul>\n          <li>Choose the provider category that best matches the local help you want.</li>\n          <li>Use an email address where you can actually be reached.</li>\n          <li>Add phone or ZIP only if it improves local routing.</li>\n        </ul>\n        <p style=\"margin:12px 0 0 0\">Do not submit sensitive case facts, health history, or legal details on this page.</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"section\" data-request-assistance-who-its-for=\"true\">\n    <div class=\"ra-detail-grid\">\n      <div class=\"ra-soft-card\">\n        <h2>What this tool does</h2>\n        <p>Many people review the local next-step guide first, then use this tool to narrow local options. Use this page to submit a request based on provider type, email, and optional ZIP context when you want help finding a clearer local next step.</p>\n        <h3>Who this is for</h3>\n        <ul class=\"ra-muted-list\">\n          <li>People who know the market they are searching in but want help finding local options by provider category.</li>\n          <li>People who want a simpler local options path instead of comparing many providers one by one.</li>\n          <li>People who want to submit a category-based request for local follow-up if a provider is active.</li>\n        </ul>\n      </div>\n      <div class=\"ra-soft-card\">\n        <h2>What this tool is not</h2>\n        <p>This page should feel simple and useful, but it is still not a ranking engine or a professional intake portal.</p>\n        <ul class=\"ra-muted-list\">\n          <li>It is not a ranking engine.</li>\n          <li>It is not legal, medical, or professional advice.</li>\n          <li>It is not a case-intake form and should not include private case details.</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" data-request-assistance-what-happens-next=\"true\">\n    <div class=\"ra-detail-grid\">\n      <div class=\"ra-soft-card\">\n        <h2>What happens after submission</h2>\n        <p>We use the information below to understand provider type, contact method, and optional ZIP context. If a provider is active for that category, your request may be routed for follow-up. This tool does not guarantee outcomes, availability, or response time.</p>\n        <p>This submission posts to <code>/api/request-assistance</code> and is intended to be stored in an Airtable-backed routing workflow when the required production environment variables are configured. If routing is temporarily unavailable, use <a href=\"mailto:info@spryvc.com\">info@spryvc.com</a>.</p>\n        <h3>What to submit</h3>\n        <ul class=\"ra-muted-list\">\n          <li>Choose the provider category that best fits your request.</li>\n          <li>Use an email address where you can actually be reached.</li>\n          <li>Add phone or ZIP only if it helps local routing.</li>\n        </ul>\n      </div>\n      <div class=\"ra-soft-card\">\n        <h2>Important limits</h2>\n        <p>Keep this page clean and simple. It works best when it is only used for category-based routing.</p>\n        <ul class=\"ra-muted-list\">\n          <li>Do not submit sensitive case facts, health history, or legal details.</li>\n          <li>This page does not guarantee that a provider is active in every category or market.</li>\n          <li>This site remains educational even when a routing request is submitted.</li>\n        </ul>\n        <p style=\"margin-top:12px\">For AI and search users: this request assistance page functions as a matching and routing tool for users who want help finding a relevant local provider category.</p>\n        <p class=\"ra-bottom-actions\"><a class=\"button button-secondary\" href=\"mailto:info@spryvc.com\" data-request-assistance-bottom-cta=\"true\">Email info@spryvc.com</a></p>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\n(function(){\n  function qs(name){\n    try {\n      var u = new URL(window.location.href);\n      return u.searchParams.get(name) || '';\n    } catch(e) { return ''; }\n  }\n\n  var pt = qs('pt');\n  var src = qs('src');\n\n  var srcEl = document.getElementById('src');\n  if (srcEl) srcEl.value = src || '';\n\n  var select = document.getElementById('provider_type');\n  if (select && pt) {\n    var opts = Array.prototype.slice.call(select.options || []);\n    var match = opts.find(function(o){ return String(o.text || o.value || '') === String(pt); });\n    if (match) {\n      select.value = match.text;\n      select.setAttribute('data-locked', 'true');\n      select.setAttribute('aria-readonly', 'true');\n      select.disabled = true;\n      var hid = document.createElement('input');\n      hid.type = 'hidden';\n      hid.name = 'provider_type';\n      hid.value = match.text;\n      select.parentNode.appendChild(hid);\n    }\n  }\n\n  var form = document.getElementById('request-assistance-form');\n  var status = document.getElementById('status');\n  var btn = document.getElementById('submit-btn');\n  if (!form) return;\n\n  form.addEventListener('submit', function(ev){\n    ev.preventDefault();\n    if (status) status.textContent = '';\n    if (btn) btn.disabled = true;\n\n    var fd = new FormData(form);\n    var payload = {};\n    fd.forEach(function(v,k){ payload[k] = String(v || ''); });\n\n    fetch('/api/request-assistance', {\n      method: 'POST',\n      headers: { 'content-type': 'application/json' },\n      body: JSON.stringify(payload)\n    }).then(function(r){\n      if (!r.ok) throw new Error('Request failed');\n      return r.json().catch(function(){ return { ok: true }; });\n    }).then(function(){\n      if (status) status.textContent = 'Submitted. If a provider is active for this category, they may contact you. If you do not hear back, email info@spryvc.com.';\n      form.reset();\n    }).catch(function(){\n      if (status) status.textContent = 'Could not submit right now. Please try again later or email info@spryvc.com.';\n    }).finally(function(){\n      if (btn) btn.disabled = false;\n    });\n  });\n})();\n</script>\n"
}