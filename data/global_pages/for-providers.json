{
  "route": "/for-providers/",
  "title": "Advertising & Provider Info",
  "description": "Buyout coverage, sponsor-owned CTA flow, and provider inquiry details.",
  "main_html": "\n<section class=\"hero for-providers-hero\">\n  <p class=\"kicker\">Buyout coverage</p>\n  <h1>Advertising &amp; Provider Info</h1>\n  <p class=\"muted\">We do not sell shared ad placements. We sell ownership of the decision layer.</p>\n</section>\n\n<section class=\"section for-providers-summary\">\n  <h2>Overview</h2>\n  <p>When no buyout is active, the page-level CTA flow and lead form belong to the platform. When a buyout is active, those same runtime surfaces become sponsor-owned for the covered page.</p>\n  <p class=\"muted\">Runtime CTAs are the source of truth. We do not force a fixed CTA count across all page types.</p>\n</section>\n\n<section class=\"section notice\" data-sales-page-contract=\"true\">\n  <h2>Sales page contract</h2>\n  <p class=\"muted\">This page is the authoritative public buyout and routing document. It is <strong>not</strong> a live sponsor surface.</p>\n</section>\n\n<section class=\"section for-providers-commercial\">\n  <h2>Sponsorship Options</h2>\n  <p class=\"muted\">Pricing varies based on market size, competition, and existing sponsor coverage.</p>\n  <div class=\"tiers\">\n    <div class=\"tier\">\n      <h3>City Buyout</h3>\n      <p class=\"price-anchor\">Starting at $2,500/month</p>\n      <p>Own all high-intent demand for a single city.</p>\n      <ul>\n        <li>Sponsor-owned CTAs on that city page</li>\n        <li>All leads routed directly to your firm</li>\n        <li>Control of the primary decision points</li>\n      </ul>\n      <div class=\"actions\"><a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20City%20Buyout&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%20City%20Buyout%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0ATimeline%3A%0AHow%20did%20you%20find%20us%3A%0A\">Check availability</a></div>\n    </div>\n    <div class=\"tier\">\n      <h3>State Buyout</h3>\n      <p class=\"price-anchor\">Starting at $7,500/month</p>\n      <p>Own demand across an entire state.</p>\n      <ul>\n        <li>Sponsor-owned CTAs across the state page</li>\n        <li>Exclusive lead routing</li>\n        <li>Coverage across key decision surfaces</li>\n      </ul>\n      <div class=\"actions\"><a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20State%20Buyout&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%20State%20Buyout%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0ATimeline%3A%0AHow%20did%20you%20find%20us%3A%0A\">Check availability</a></div>\n    </div>\n    <div class=\"tier\">\n      <h3>Vertical Buyout</h3>\n      <p class=\"price-anchor\">Starting at $25,000/month</p>\n      <p>Own the entire category across guides, states, and select cities.</p>\n      <ul>\n        <li>Homepage</li>\n        <li>All guide pages</li>\n        <li>Up to 10 cities</li>\n        <li>Corresponding states</li>\n        <li>Additional cities available</li>\n      </ul>\n      <div class=\"actions\"><a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20Vertical%20Buyout&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%20Vertical%20Buyout%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0ATimeline%3A%0AHow%20did%20you%20find%20us%3A%0A\">Check availability</a></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\">\n  <h2>Products</h2>\n  <div class=\"tiers\">\n    <div class=\"tier\">\n      <h3>City Buyout</h3>\n      <ul>\n        <li>Owns sponsor-visible CTA routing on that city page</li>\n        <li>Owns sponsor lead flow on that city page</li>\n        <li>If a directory exists, the CTA above the directory becomes the sponsor feature surface</li>\n      </ul>\n      <div class=\"actions\"><a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20City%20Buyout&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0AHow%20did%20you%20find%20us%3A%0A\">Sponsorship inquiry</a></div>\n    </div>\n    <div class=\"tier\">\n      <h3>State Buyout</h3>\n      <ul>\n        <li>Owns sponsor-visible CTA routing on that state page</li>\n        <li>Owns sponsor lead flow on that state page</li>\n        <li>If a directory exists, the CTA above the directory becomes the sponsor feature surface</li>\n      </ul>\n      <div class=\"actions\"><a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20State%20Buyout&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0AHow%20did%20you%20find%20us%3A%0A\">Sponsorship inquiry</a></div>\n    </div>\n    <div class=\"tier\">\n      <h3>Vertical Buyout</h3>\n      <ul>\n        <li>Includes homepage / vertical hub coverage</li>\n        <li>Includes all guide pages</li>\n        <li>Includes up to 10 cities by default, plus corresponding states</li>\n        <li>Additional cities are available as a paid expansion</li>\n        <li>Personal Injury excludes city pages because those pages are not rendered</li>\n      </ul>\n      <div class=\"actions\"><a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20Vertical%20Buyout&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0AHow%20did%20you%20find%20us%3A%0A\">Sponsorship inquiry</a></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\">\n  <h2>How sponsor ownership works</h2>\n  <ul>\n    <li>Buyout active = sponsor-owned CTA routing on covered pages</li>\n    <li>Buyout active = sponsor-owned lead routing on covered pages</li>\n    <li>CTA above a directory becomes the sponsor feature surface where a directory exists</li>\n    <li>Directories remain visible and neutral; we do not reorder them to fake rankings</li>\n    <li>No adjacent CTAs are allowed; CTA blocks must always be separated by content</li>\n    <li>Personal Injury excludes city pages</li>\n  </ul>\n</section>\n\n<section class=\"section for-providers-mechanics\">\n  <h2>Visual explanation</h2>\n  <div class=\"visuals-list\">\n    <details class=\"visual-card accordion\">\n      <summary>Clean page vs owned page</summary>\n      <div class=\"svg-wrap\"><figure class=\"for-providers-visual\"><img src=\"/assets/for-providers/clean-vs-owned-page.png\" alt=\"Side-by-side example of a clean page with platform-owned CTAs and an owned page with sponsor-owned CTAs.\" loading=\"lazy\" decoding=\"async\"><figcaption>Clean pages keep the platform CTA flow. Owned pages switch the same runtime CTA surfaces into sponsor-owned decision points.</figcaption></figure></div>\n    </details>\n    <details class=\"visual-card accordion\">\n      <summary>Composite buyout coverage</summary>\n      <div class=\"svg-wrap\"><figure class=\"for-providers-visual\"><img src=\"/assets/for-providers/composite-buyout-coverage.png\" alt=\"Composite visual showing homepage, state page, guide page, and eligible city page coverage with sponsor-owned CTA surfaces highlighted.\" loading=\"lazy\" decoding=\"async\"><figcaption>Vertical buyout covers homepage, all guides, and the covered market pages in the contract. CTA ownership is highlighted because the CTA layer is the monetized decision surface.</figcaption></figure></div>\n      <p class=\"muted\">Vertical buyout includes homepage, all guide pages, up to 10 cities by default, and the corresponding states. Existing active city or state contracts are not silently overridden.</p>\n    </details>\n    <details class=\"visual-card accordion\">\n      <summary>Directory CTA feature</summary>\n      <div class=\"svg-wrap\"><figure class=\"for-providers-visual\"><img src=\"/assets/for-providers/directory-cta-feature.png\" alt=\"Directory page example where the CTA block above the directory becomes the sponsor feature surface while the directory listings remain visible and neutral.\" loading=\"lazy\" decoding=\"async\"><figcaption>The CTA directly above a directory becomes the sponsor feature surface under buyout. The directory stays visible for context and is not reordered to fake rankings.</figcaption></figure></div>\n    </details>\n    <details class=\"visual-card accordion\">\n      <summary>Sponsor lead form example</summary>\n      <div class=\"svg-wrap\"><figure class=\"for-providers-visual\"><img src=\"/assets/for-providers/sponsor-lead-flow.png\" alt=\"Sponsor-owned lead flow example showing CTA click, sponsor-branded inquiry form, and exclusive lead delivery to the sponsor.\" loading=\"lazy\" decoding=\"async\"><figcaption>On a bought-out page the lead form follows the same sponsor-owned path as the CTA layer, and all captured leads route directly to the sponsor.</figcaption></figure></div>\n      <p class=\"note\"><strong>Lead routing note:</strong> All leads submitted through this sponsor flow go to the sponsor when buyout routing is active.</p>\n    </details>\n  </div>\n</section>\n\n<section class=\"section for-providers-inquiry\">\n  <h2>Start a sponsorship inquiry</h2>\n  <p class=\"muted\">Use the inquiry button below if you want a City Buyout, State Buyout, or Vertical Buyout.</p>\n  <div class=\"actions\">\n    <a class=\"btn primary\" href=\"mailto:info@spryvc.com?subject=Sponsorship%20Inquiry%20%E2%80%94%20The%20Industry%20Guides&body=Full%20name%3A%0AWork%20email%3A%0APhone%3A%0AFirm%20name%3A%0AFirm%20type%3A%0AInterested%20in%3A%0APrimary%20markets%3A%0AEstimated%20monthly%20budget%3A%0AHow%20did%20you%20find%20us%3A%0A\">Start inquiry</a>\n  </div>\n</section>\n\n<script type=\"application/json\" id=\"canonical-ad-inventory-v1\">\n{\n  \"version\": \"CANONICAL_AD_INVENTORY_V1\",\n  \"model\": \"buyout_only_cta_and_lead_flow\",\n  \"surfaces\": {\n    \"guide\": {\n      \"placements\": [\n        \"top\",\n        \"bottom\"\n      ],\n      \"availability\": \"vertical_buyout_only\",\n      \"cta_source_of_truth\": \"runtime\",\n      \"lead_flow\": \"sponsor_when_buyout_active\"\n    },\n    \"city\": {\n      \"placements\": [\n        \"top\",\n        \"mid\",\n        \"bottom\"\n      ],\n      \"availability\": \"city_buyout_or_vertical_buyout_when_covered\",\n      \"cta_source_of_truth\": \"runtime\",\n      \"lead_flow\": \"sponsor_when_buyout_active\"\n    },\n    \"state\": {\n      \"placements\": [\n        \"top\",\n        \"mid\"\n      ],\n      \"availability\": \"state_buyout_or_vertical_buyout_when_covered\",\n      \"cta_source_of_truth\": \"runtime\",\n      \"lead_flow\": \"sponsor_when_buyout_active\"\n    },\n    \"state_pi\": {\n      \"placements\": [\n        \"top\",\n        \"mid\"\n      ],\n      \"availability\": \"state_buyout_or_vertical_buyout_when_covered\",\n      \"cta_source_of_truth\": \"runtime\",\n      \"lead_flow\": \"sponsor_when_buyout_active\"\n    },\n    \"vertical_hub\": {\n      \"placements\": [\n        \"hero\"\n      ],\n      \"availability\": \"vertical_buyout_only\",\n      \"cta_source_of_truth\": \"runtime\",\n      \"lead_flow\": \"sponsor_when_buyout_active\"\n    }\n  },\n  \"products\": {\n    \"city_buyout\": {\n      \"includes\": [\n        \"city_cta_layer\",\n        \"city_lead_flow\",\n        \"directory_entry_cta_when_present\"\n      ]\n    },\n    \"state_buyout\": {\n      \"includes\": [\n        \"state_cta_layer\",\n        \"state_lead_flow\",\n        \"directory_entry_cta_when_present\"\n      ]\n    },\n    \"vertical_buyout\": {\n      \"includes\": [\n        \"vertical_hub\",\n        \"guide\",\n        \"cta_layer\",\n        \"lead_flow\",\n        \"up_to_10_cities\",\n        \"corresponding_states\"\n      ],\n      \"pi_city_pages_rendered\": false,\n      \"additional_city_pricing\": \"contract_required\"\n    }\n  },\n  \"runtime_conversion_flow\": {\n    \"surface_renderer\": \"shared_sponsor_surface_renderer\",\n    \"cta_model\": \"runtime_ctas_are_source_of_truth\",\n    \"directory_feature_rule\": \"cta_above_directory_becomes_sponsor_feature_surface\",\n    \"lead_destination\": \"all_leads_go_to_sponsor_when_buyout_is_active\",\n    \"training_behavior\": \"starter_v1_may_replay_the_same_surface_modes_using_fake_sponsor_data\"\n  },\n  \"guardrails\": {\n    \"cta_adjacency\": \"forbidden\",\n    \"guide_shared_inventory\": \"forbidden\",\n    \"directory_reordering\": \"forbidden\"\n  }\n}\n</script>\n"
}