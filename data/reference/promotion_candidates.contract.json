{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo 2 to Repo 3 Promotion Candidates Contract",
  "type": "object",
  "required": ["contract_version", "source_repo", "generated_at", "candidates"],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "source_repo": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "vertical", "query", "cluster", "source", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "vertical": { "type": "string", "minLength": 1 },
          "geo": { "type": ["string", "null"] },
          "query": { "type": "string", "minLength": 1 },
          "cluster": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": { "type": "string", "minLength": 1 },
          "confidence": { "type": ["number", "null"] },
          "evidence": { "type": ["object", "array", "null"] },
          "status": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
