{
  "schema": "search-loop-canonical-v1",
  "_what": "The shared search loop (seq23/search-loop @v1) on the CANONICAL side of the Industry Guides. Owner ruling 1 Nov 2026 (spry brain, 'Search growth loop on every selling site'): the velocity repo builds the daily new pages; this repo gets no daily new-page build. It runs MEASURE + CHECK/REPAIR on its guides and a MISSING-GUIDE stage: a topic the velocity repo lists with no canonical guide is built here as a full, sourced, gated guide and published straight away. Runner: scripts/search_loop/canonical_loop.mjs. Each sites[] entry, merged with the shared keys below, must pass the engine's own config check (search-loop-config-v1); tests/search_loop/canonical_loop.test.mjs proves it.",
  "engine_ref": "v1",
  "new_pages": "missing_guides_only",
  "missing_guides": {
    "source_url": "https://raw.githubusercontent.com/seq23/local-guides-citation-velocity/main/data/search-loop/missing-guides.json",
    "source_note": "Written by the velocity repo's search loop: topics it covers that have no canonical guide. Accepted shapes: a list, or {items|missing|guides:[...]}, each item {query|topic|title, vertical|site|host}.",
    "weekly_cap_from": "data/cadence/policy.json#new_pages_per_week",
    "min_words": 1200,
    "min_verified_sources": 2,
    "retry_after_days": 28
  },
  "mode": "normal",
  "pace": {
    "start_per_day": 10,
    "step_per_week": 5,
    "cap": 30,
    "min_per_day": 2
  },
  "menu_pages_need_approval": false,
  "voice": "neutral, factual and helpful; plain language; shows its sources; educational only; no endorsements, rankings, guarantees or outcome promises",
