  "main_html": "<section class=\"hero training-marker\" data-training-page=\"true\" style=\"background:#fff3cd;border:3px solid #d97706;border-radius:18px;padding:20px;margin-bottom:20px\"><p class=\"kicker\">TRAINING PAGE</p><h1 style=\"margin:0 0 10px 0\">Training page</h1><p><strong>Sandbox only.</strong> Not a production or sponsor-facing page.</p><p class=\"muted\">This page is copied from the real canonical pack and marked as training.</p></section>\n<section class=\"hero\" data-pi-home-hero=\"true\">\n  <p class=\"kicker\">The Accident Guides \u00b7 Independent educational publisher</p>\n  <h1>The Accident Guides</h1>\n  <p class=\"muted\">The Accident Guides explains what to do after an injury, how personal injury claims work, and how to compare firms using state guides and canonical educational resources. We do not rate, rank, or endorse providers. Content is educational only and not legal advice.</p>\n</section>\n\n<section class=\"section conversion-cta conversion-cta--primary\" data-primary-conversion-cta=\"true\">\n  <div class=\"conversion-cta__panel conversion-cta__panel--primary\">\n    <p class=\"conversion-cta__eyebrow\">Start here</p>\n    <h2 class=\"conversion-cta__heading\">View your next steps</h2>\n    <p class=\"conversion-cta__body\">Use the dedicated next-steps path after you review the homepage short answer, provider preview, and state routing.</p>\n    <p class=\"conversion-cta__actions\">\n      <a class=\"button button-primary conversion-cta__button\" href=\"https://local-guides-generator.pages.dev/next-steps/?src=%2F&amp;intent=decision_hub&amp;button=next_steps_cta&amp;vertical=pi&amp;page_kind=global&amp;page_slug=home\" data-provider-type=\"Personal Injury Attorney\" data-page-src=\"https://local-guides-generator.pages.dev/\" data-button-source=\"next_steps_cta\" data-intent-type=\"decision_hub\" data-market-slug=\"\" data-page-kind=\"global\" data-vertical-key=\"pi\">View Your Next Steps</a>\n    </p>\n  </div>\n</section>\n\n<sec