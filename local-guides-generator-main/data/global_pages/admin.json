{
  "route": "/admin/",
  "title": "Operator Admin | %%BRAND_NAME%%",
  "description": "Lightweight operator page for sponsorship status, inventory visibility, and activation instructions.",
  "main_html": "<style>\n    .admin-gate{border:1px solid rgba(11,31,58,.14);border-radius:20px;padding:24px;background:#fff;box-shadow:0 12px 24px rgba(11,31,58,.08);max-width:720px;margin:0 auto 24px auto}\n    .admin-shell{display:none}\n    .admin-shell.is-open{display:block}\n    .admin-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}\n    .admin-card{border:1px solid rgba(11,31,58,.12);border-radius:18px;padding:18px;background:#fff}\n    .admin-note{font-size:.95rem;color:#4b5b73}\n    .admin-pill{display:inline-block;padding:4px 10px;border-radius:999px;background:#eef4fb;color:#16375f;font-size:.85rem;margin:0 6px 6px 0}\n    .admin-table{width:100%;border-collapse:collapse;font-size:.95rem}\n    .admin-table th,.admin-table td{padding:10px 8px;border-bottom:1px solid rgba(11,31,58,.10);text-align:left;vertical-align:top}\n    .admin-code{background:#0f172a;color:#f8fafc;border-radius:14px;padding:14px;overflow:auto;font-size:.92rem}\n    .admin-alert{border-left:4px solid #1f4f8a;padding:12px 14px;background:#eef4fb;border-radius:12px}\n    .admin-warn{border-left-color:#8a4f1f;background:#fcf4ee}\n    .admin-mini{font-size:.9rem;color:#5b6475}\n    .admin-details summary{cursor:pointer;font-weight:600}\n  </style>\n\n  <section class=\"hero\">\n    <p class=\"kicker\">Operator panel</p>\n    <h1>/admin</h1>\n    <p class=\"muted\">Lightweight operator page for sponsorship status, free vs taken inventory, and activation instructions.</p>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"admin-gate\" id=\"admin-gate\" data-admin-gate=\"true\">\n      <h2>Enter password</h2>\n      <p class=\"admin-note\">This is a lightweight visibility gate for operators. It is not secure authentication.</p>\n      <label for=\"admin-password\"><strong>Password</strong></label>\n      <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:10px\">\n        <input id=\"admin-password\" type=\"password\" placeholder=\"Enter password\" style=\"flex:1;min-width:220px;padding:12px 14px;border:1px solid rgba(11,31,58,.2);border-radius:12px\" />\n        <button id=\"admin-open\" type=\"button\" style=\"padding:12px 18px;border:0;border-radius:12px;background:#16375f;color:#fff;font-weight:600\">Open admin</button>\n      </div>\n      <p id=\"admin-error\" class=\"admin-mini\" style=\"display:none;color:#9f1239;margin-top:10px\">Incorrect password.</p>\n    </div>\n  </section>\n\n  <div id=\"admin-shell\" class=\"admin-shell\" data-admin-shell=\"true\">\n    <section class=\"section\">\n      <div class=\"admin-alert\">\n        <strong>What this page is for:</strong> give a VA one place to see what is free vs taken, what each product includes, exactly how to activate or turn off a sponsor, and how to get oriented in the training pack before touching the real repo. <a href=\"https://local-guides-generator.pages.dev/\" target=\"_blank\" rel=\"noopener\">Open training/public site</a>.\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <h2>Current snapshot</h2>\n      %%ADMIN_STATUS_CARDS%%\n    </section>\n\n    <section class=\"section\">\n      <h2>Products you can sell</h2>\n      %%ADMIN_PRODUCT_SUMMARY%%\n    </section>\n\n    <section class=\"section\">\n      <h2>Inventory and conflicts</h2>\n      %%ADMIN_INVENTORY_TABLE%%\n    </section>\n\n    <section class=\"section\">\n      <h2>CTA and lead-routing status</h2>\n      %%ADMIN_CTA_STATUS%%\n    </section>\n\n    <section class=\"section\">\n      <h2>Activation checklist</h2>\n      %%ADMIN_ACTIVATION_CHECKLIST%%\n  <div class=\"admin-card\"><h3>Add missing cities</h3>%%ADMIN_CITY_REQUEST_GUIDE%%</div>\n    </section>\n\n    <section class=\"section\">\n      <h2>Operator docs</h2>\n      <div class=\"admin-card\" data-admin-operator-docs=\"true\">\n        <p><strong>START HERE:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/START_HERE.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>Repo Architecture Primer:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/REPO_ARCHITECTURE_PRIMER.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>LLM prompts:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/LLM_PROMPTS.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>Global Repository Operations Manual:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/GLOBAL_REPOSITORY_OPERATIONS_MANUAL_v6.4_MASTER_EDITION.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>Listings Master Index:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/LISTINGS_MASTER_INDEX.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>Head VA Operations Runbook:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/HEAD_VA_OPERATIONS_RUNBOOK.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>VA Quick SOP:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/VA_QUICK_SOP.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>City Addition Runbook:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/CITY_ADDITION_RUNBOOK.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n        <p><strong>Sponsor Activation Runbook:</strong> <a href=\"https://github.com/seq23/local-guides-generator/blob/main/docs/SPONSOR_ACTIVATION_RUNBOOK.md\" target=\"_blank\" rel=\"noopener\">open on GitHub</a></p>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <h2>Head VA city creation paths</h2>\n      <div class=\"admin-grid\" data-admin-city-paths=\"true\">\n        <div class=\"admin-card\">\n          <h3>Local repo path</h3>\n          <ol>\n            <li>Fill out <code>data/templates/city_request.template.json</code></li>\n            <li>Run <code>node scripts/scaffold_city_from_request.js data/templates/city_request.template.json --apply</code></li>\n            <li>Rebuild and validate</li>\n            <li>Click-audit affected pages</li>\n          </ol>\n        </div>\n        <div class=\"admin-card\">\n          <h3>GitHub path</h3>\n          <ol>\n            <li>Open GitHub → Actions</li>\n            <li>Run <strong>Add City Request</strong></li>\n            <li>Fill in the structured inputs</li>\n            <li>Review the generated PR and merge after validation passes</li>\n          </ol>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <h2>Red flags</h2>\n      %%ADMIN_RED_FLAGS%%\n    </section>\n\n    <section class=\"section\">\n      <details class=\"admin-details\">\n        <summary>Quick commands</summary>\n        <div class=\"admin-code\">npm run build\nPAGE_SET_FILE=%%PAGE_SET_FILE%% LKG_VALIDATE_DIST=1 npm run validate:all</div>\n      </details>\n    </section>\n  </div>\n\n  <script>\n  (function(){\n    var btn=document.getElementById('admin-open');\n    var input=document.getElementById('admin-password');\n    var shell=document.getElementById('admin-shell');\n    var gate=document.getElementById('admin-gate');\n    var err=document.getElementById('admin-error');\n    function openGate(){\n      if((input.value||'')==='admin'){\n        shell.classList.add('is-open');\n        gate.style.display='none';\n        err.style.display='none';\n      } else {\n        err.style.display='block';\n      }\n    }\n    btn.addEventListener('click', openGate);\n    input.addEventListener('keydown', function(e){ if(e.key==='Enter') openGate(); });\n  })();\n  </script>"
}
