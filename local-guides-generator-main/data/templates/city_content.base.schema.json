    "primary_city_decision_block"
  ],
  "field_types": {
    "market_specific_notes": "array:string",
    "local_vetting_points": "array:string",
    "typical_cost_ranges": "array:string",
    "payment_options": "array:string",
    "wait_time_notes": "array:string",
    "availability_notes": "array:string",
